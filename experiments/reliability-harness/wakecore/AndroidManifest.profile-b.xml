<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.alvorada.reliability.wakecore"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk
        android:minSdkVersion="31"
        android:targetSdkVersion="36" />

    <!-- PROFILE B: USE_EXACT_ALARM route ONLY (exercises automatic system-granted access) -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Boot completed and wakelock permissions -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Wake session notifications and foreground service (API 34+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:label="AlvoradaWakeCoreProfileB"
        android:hasCode="true"
        android:directBootAware="true">

        <receiver
            android:name=".WakeAlarmReceiver"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="org.alvorada.reliability.wakecore.ALARM_TRIGGER" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".WakeBootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".WakeControlReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="org.alvorada.reliability.wakecore.COMMAND" />
            </intent-filter>
        </receiver>

        <service
            android:name=".WakeSessionService"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="mediaPlayback" />

    </application>

</manifest>
